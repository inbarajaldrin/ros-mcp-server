+    def _find_hole_directed_wrench(self, t: float, tcp_xy: tuple[float, float],
+                                   F_lat_baselink: tuple[float, float]
+                                   ) -> tuple[tuple, float, float, tuple, dict]:
+        """H101: directed sweep — push toward (seat_xy - tcp_xy), rotate every dwell.
+
+        Backed by I003 (operator direction = c→s), I004 (1.2-1.7 mm disp), I005 (2-3 N
+        reaction). Replay-tuned magnitude 3 N produces 1.6 mm disp at 1 s, matching GOLD
+        median. If no Fz collapse latches, rotate direction by `rotate_deg` each
+        `dwell_s` for up to `n_directions`.
+        """
+        # Seat prior: prefer override (hole_xy_prior), else CAD-derived predicted xy.
+        if self.spiral_origin_override is not None:
+            seat_xy = (float(self.spiral_origin_override[0]),
+                       float(self.spiral_origin_override[1]))
+        elif self.predicted_tcp_xy is not None:
+            seat_xy = (float(self.predicted_tcp_xy[0]),
+                       float(self.predicted_tcp_xy[1]))
+        else:
+            # No seat prior available — fall back to spiral.
+            return self._find_hole_wrench_spiral(t, tcp_xy)
+
+        if self._find_hole_start_t is None:
+            t_post = 0.0
+        else:
+            t_post = max(0.0, t - self._find_hole_start_t)
+
+        dx = seat_xy[0] - tcp_xy[0]
+        dy = seat_xy[1] - tcp_xy[1]
+        dist = math.hypot(dx, dy)
+        if dist < 1e-4:
+            ux, uy = 0.0, 0.0
+        else:
+            ux, uy = dx / dist, dy / dist
+
+        f_lat_mag = math.hypot(F_lat_baselink[0], F_lat_baselink[1])
+        latched = f_lat_mag > self.find_hole_directed_latch_F_N
+        if not latched and dist >= 1e-4:
+            idx = min(int(t_post / max(self.find_hole_directed_dwell_s, 1e-3)),
+                      self.find_hole_directed_n_directions - 1)
+            theta = math.radians(idx * self.find_hole_directed_rotate_deg)
+            c, s = math.cos(theta), math.sin(theta)
+            ux, uy = (c * ux - s * uy, s * ux + c * uy)
+
+        # base → base_link sign flip (matches existing convention in _find_hole_wrench)
+        Fx = -self.find_hole_directed_F_N * ux
+        Fy = -self.find_hole_directed_F_N * uy
+        wrench = (Fx, Fy, -self.find_hole_fz_N, 0.0, 0.0, 0.0)
+        sel = (True, True, True, True, True, True)
+        info = {
+            "directed_seat_xy_m": seat_xy,
+            "directed_dir_baselink": (ux, uy),
+            "directed_latched": latched,
+            "directed_dist_to_seat_mm": dist * 1000.0,
+        }
+        return wrench, self.gain_find_hole, self.damping_find_hole, sel, info
+
     def _find_hole_wrench(self, t: float, tcp_xy: tuple[float, float]) -> tuple[tuple, float, float, tuple, dict]:
         """FIND_HOLE wrench: PD-derived spiral xy + Fz. Stankowski Archimedean."""
