Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 12
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: UR5e
      Description Source: Topic
      Description Topic:
        Durability Policy: Transient Local
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RG2_authentic
      Description Source: Topic
      Description Topic:
        Durability Policy: Transient Local
        Value: /rg2ref/robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.12
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Frames:
        tool0: {Value: true}
        quick_changer_link: {Value: true}
        rg2_base_link: {Value: true}
        rg2_hand_link: {Value: true}
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point: {X: 0.1, Y: 0.0, Z: 0.4}
      Pitch: 0.35
      Yaw: 0.9
